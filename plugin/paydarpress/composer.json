{
    "name": "paydarwp/paydarpress",
    "description": "PaydarPress - site intelligence, content audit and AI-assisted content management for WordPress.",
    "type": "wordpress-plugin",
    "license": "proprietary",
    "require": {
        "php": ">=8.0"
    },
    "autoload": {
        "psr-4": {
            "PaydarWP\\PaydarPress\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PaydarWP\\PaydarPress\\Tests\\": "tests/"
        }
    },
    "config": {
        "platform": {
            "php": "8.0.30"
        },
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
